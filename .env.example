# Copy to .env locally; .env is ignored. Never commit an actual API key.
DEEPSEEK_API_KEY=
GAMEBRIDGE_API_BASE=https://api.deepseek.com
GAMEBRIDGE_MODEL=deepseek-flash
GAMEBRIDGE_PORT=4173
GAMEBRIDGE_GAME_PATH=
# Optional absolute path; otherwise probes .tools/dotnet and PATH.
GAMEBRIDGE_DOTNET_PATH=
# Optional Mac tModLoader preflight only; not used by the SMAPI pipeline.
# Requires a genuine local v2026.08.3.0 install; no game download or execution.
GAMEBRIDGE_TML_PATH=
# Optional absolute path; defaults to .tools/dotnet8-x64/dotnet (SDK 8.0.427 x64).
GAMEBRIDGE_TML_DOTNET_PATH=
