# Copy to .env locally; .env is ignored. Never commit an actual API key.
DEEPSEEK_API_KEY=
GAMEBRIDGE_API_BASE=https://api.deepseek.com
GAMEBRIDGE_MODEL=deepseek-flash
GAMEBRIDGE_PORT=4173
# Optional absolute local state directory; defaults to project-local .gamebridge/.
# Run snapshots exclude credentials. This directory must not be published.
GAMEBRIDGE_STATE_PATH=
