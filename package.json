{
  "name": "gamebridge",
  "version": "0.8.1-alpha.1",
  "private": true,
  "type": "module",
  "description": "Cross-game AI conversion planning, adapter contracts and evidence-gated workflows",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test",
    "build": "node scripts/build.mjs",
    "verify:sandbox": "node scripts/verify-converter-sandbox.mjs",
    "verify:execution": "node scripts/verify-execution-kernel.mjs",
    "verify:diagnostics": "node scripts/verify-compiler-diagnostics.mjs",
    "verify:host": "node scripts/verify-host-supertux.mjs",
    "behavior:compile": "node scripts/compile-behavior.mjs",
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env scripts/workbench.mjs",
    "github:publish": "node scripts/publish-github.mjs"
  }
}
