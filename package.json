{
  "name": "gamebridge",
  "version": "0.5.0-alpha.1",
  "private": true,
  "type": "module",
  "description": "AI action-rule design, host capability gates and bounded Mod development workflow",
  "engines": { "node": ">=24" },
  "scripts": {
    "test": "node --test",
    "test:sandbox": "node --env-file-if-exists=.env scripts/verify-sandbox.mjs",
    "verify:actions": "node --env-file-if-exists=.env scripts/verify-action-design.mjs",
    "build": "node scripts/build.mjs",
    "dev": "node scripts/build.mjs && node --env-file-if-exists=.env scripts/workbench.mjs",
    "github:publish": "node scripts/publish-github.mjs"
  }
}
